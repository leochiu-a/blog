# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# astro
/.astro/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Worker-side local secrets: read by `next dev` through getPlatformProxy, and
# by `wrangler types`. Holds real values — never commit it.
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content-collections generated output
/.content-collections/

# local planning & research docs
/docs/*
# ...except the decision records and the setup a fresh clone needs. Git
# cannot re-include a path under an excluded directory, hence /docs/* above.
!/docs/adr/
!/docs/newsletter-setup.md
/.planning/
/.migration/

# local tooling
/.claude/

# cloudflare / opennext
.open-next/
.wrangler/
# Generated from wrangler.jsonc by `wrangler types`, and regenerated on install
# and before every build — committing it would only be 16k lines of diff that
# can silently disagree with the config it came from.
worker-configuration.d.ts
